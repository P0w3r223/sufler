# Spójna normalizacja końców linii między systemami (LF w repozytorium).
* text=auto

# Skrypty specyficzne dla Windows zachowują CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Pliki WYKONYWANE NA LINUKSIE — zawsze LF, niezależnie od platformy autora.
# Bez tego `core.autocrlf=true` daje CRLF przy checkoucie na Windows, a wtedy:
#   *.sh              → `bad interpreter: /usr/bin/env bash^M`
#   env / env.example → wartość zmiennej kończy się na \r; `config._get()` NIE robi strip(),
#                       więc np. TEAM_ID trafiłby z \r do URL-a Grapha (błąd nie do zdiagnozowania)
#   Dockerfile        → łamie kontynuacje `\` w RUN
#   *.service         → systemd nie parsuje dyrektyw z \r
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
env.example     text eol=lf
.env.example    text eol=lf

# Pliki binarne — bez konwersji końców linii.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.bin  binary

# Plik blokady — bez różnicowania w recenzjach.
uv.lock -diff
