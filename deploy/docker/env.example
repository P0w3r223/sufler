# Konfiguracja floty WorkMate w kontenerach (ADR 0044). Skopiuj do `env` obok docker-compose.yml,
# uzupełnij i ustaw `chmod 640 env` (zawiera SEKRETY). Plik NIE trafia do obrazu (.dockerignore).
#
# Pełny katalog pokręteł strojących jest w ../../.env.example — tu tylko to, co istotne dla wdrożenia
# kontenerowego. Ścieżki stanu CELOWO wskazują wolumen /var/lib/workmate (współdzielony events.db,
# ADR 0019) oraz /var/lib/workmate-out (imienne godziny, PII — osobny wolumen).

# --- Które segmenty floty startują (profile compose) ---------------------------------------------
# mcp = serwer MCP + nginx; bridge = github+teams-graph. Jira nie ma tu żadnego osobnego procesu —
# odczyt "moje zadania" (ADR 0054) woła bezpośrednio teams-graph. Karty czasu (WorklogPRO) wycofane
# z projektu (ADR 0055) — profil `worklogi`/`tools` już nie istnieje.
# Domyślnie sam `mcp`: `bridge` DOKŁADAJ DOPIERO po jednorazowym primingu device-code (README §3) i
# ustawieniu WORKMATE_TEAMS_GRAPH_WATCH — inaczej teams-graph wpada w restart-loop (tryb odkrywania
# kończy proces). Docelowo np.: COMPOSE_PROFILES=mcp,bridge
COMPOSE_PROFILES=mcp

# =================================================================================================
# Ścieżki stanu na wspólnym wolumenie (NIE zmieniaj bez powodu — muszą wskazywać zamontowany wolumen)
# =================================================================================================
WORKMATE_EVENTS_DB=/var/lib/workmate/events.db
WORKMATE_CONVERSATIONS_DB=/var/lib/workmate/conversations.db
WORKMATE_RETRIEVAL_INDEX=/var/lib/workmate/retrieval_index.db
WORKMATE_GITHUB_STATE=/var/lib/workmate/github_state.json
WORKMATE_TEAMS_GRAPH_STATE=/var/lib/workmate/teams_graph_state.json
# Cache MSAL (SEKRETY, device-code). Drzwi kanału i push mają OSOBNE pliki (różne zakresy).
WORKMATE_TEAMS_GRAPH_TOKEN_CACHE=/var/lib/workmate/teams_graph_token_cache.bin
WORKMATE_TEAMS_PUSH_TOKEN_CACHE=/var/lib/workmate/teams_push_token_cache.bin

# =================================================================================================
# Runtime agenta (Faza 2) — WYMAGANY dla teams-graph
# =================================================================================================
# SEKRET. Klucz Claude API. Trzymaj TYLKO tutaj (env poza obrazem), nigdy w repo.
ANTHROPIC_API_KEY=
# WORKMATE_AGENT_MODEL=claude-sonnet-5

# =================================================================================================
# Profil `mcp` — serwer MCP po streamable-http za nginx (Bramka 3 / ADR 0007)
# =================================================================================================
# Magazyn tokenów per osoba (sha256). Wygeneruj: deploy/http/manage_tokens.py issue --person …
# i umieść na wolumenie state jako /var/lib/workmate/tokens.json.
WORKMATE_TOKENS_FILE=/var/lib/workmate/tokens.json
# Host publiczny w OBU formach (bez portu dla 443 i z :*), inaczej realny Host daje 421.
WORKMATE_ALLOWED_HOSTS=workmate.firma.pl,workmate.firma.pl:*
WORKMATE_ALLOWED_ORIGINS=https://workmate.firma.pl
# TLS terminuje nginx — uvicorn słucha po HTTP na sieci wewnętrznej, więc TLS_* zostają PUSTE.
# WORKMATE_TLS_CERTFILE=
# WORKMATE_TLS_KEYFILE=

# =================================================================================================
# Profil `bridge` — drzwi GitHub (ADR 0020)
# =================================================================================================
WORKMATE_GITHUB_TOKEN=            # SEKRET (PAT)
WORKMATE_GITHUB_OWNER=biap
WORKMATE_GITHUB_REPO=workmate
# WORKMATE_GITHUB_WATCH_KINDS=issues,comments,pulls,reviews,ci,pull_state,branches
# Zapis do GitHub — domyślnie OFF (Gate 4, ADR 0021). Poller i zapis MUSZĄ dzielić ten sam PAT.
# WORKMATE_GITHUB_ENABLE_WRITE=false
# WORKMATE_GITHUB_SELF_LOGIN=

# --- Odczyt Jira "moje zadania" (ADR 0054) — WYŁĄCZNIE odczyt, brak osobnych drzwi/pollera -------
# Konsumowane bezpośrednio przez teams-graph (mapa AAD→Jira per nadawca, patrz meeting_note_identities
# poniżej). Bez BASE_URL/TOKEN narzędzie po prostu się nie zbuduje (brak na liście agenta).
WORKMATE_JIRA_DEPLOYMENT=server   # server (PAT Bearer, REST v2) albo cloud (Basic email+token, v3)
WORKMATE_JIRA_BASE_URL=https://jira.firma.pl
WORKMATE_JIRA_TOKEN=              # SEKRET — wystarczy zakres odczytu (bez create/edit/transition)
WORKMATE_JIRA_EMAIL=              # tylko Cloud (Basic auth); na Server/DC zostaw puste
# WORKMATE_JIRA_MY_ACCOUNT=       # BEZ EFEKTU tutaj — server.py wymusza transport=streamable-http
                                  # na flocie HTTP, więc "moje zadania" NIE wchodzi na ten transport
                                  # konstrukcyjnie (jeden principal nie może obsłużyć wielu osób).
                                  # Ta zmienna ma sens WYŁĄCZNIE na lokalnym stdio (Claude Code/CLI).

# --- Profil `bridge` — drzwi Teams delegowane (ADR 0015/0016) ------------------------------------
WORKMATE_TEAMS_GRAPH_CLIENT_ID=
WORKMATE_TEAMS_GRAPH_TENANT_ID=
# Pary team_id:channel_id (po przecinku). PUSTE = tryb odkrywania (proces wypisze kanały i zakończy),
# więc w profilu bridge MUSI być ustawione, inaczej usługa restartuje się w kółko.
WORKMATE_TEAMS_GRAPH_WATCH=
# WORKMATE_TEAMS_GRAPH_POLL_INTERVAL=10
# UWAGA: produkcyjny zapis /notatka (ENABLE_MEETING_NOTE_WRITE, ADR 0041) pisze do data/notes/, a
# montaż ./data jest RO. Włączając go, zamontuj teams-graph z RW dostępem do notatek (osobny override
# compose) — inaczej zapis padnie w runtime na „Read-only file system".
# ADR 0041/0042/0043/0047/0048 accepted — bramki zapisu notatek + weryfikacja włączone.
WORKMATE_TEAMS_GRAPH_ENABLE_MEETING_TRANSCRIPT=true
WORKMATE_TEAMS_GRAPH_ENABLE_MEETING_NOTE_WRITE=true
WORKMATE_TEAMS_GRAPH_ENABLE_MEETING_NOTE_ASYNC=true
WORKMATE_TEAMS_GRAPH_ENABLE_THREAD_NOTE_CAPTURE=true
WORKMATE_TEAMS_GRAPH_IDENTITIES=/var/lib/workmate/identities.yaml
# Druga przelotka-krytyk nad notatką ze spotkania (ADR 0047) — tnie twierdzenia bez pokrycia
# w transkrypcie; przełącznik JAKOŚCI (nie bramka zapisu), dodatkowe wywołanie Claude per notatka.
WORKMATE_AGENT_VERIFY_MEETING_NOTE=true

# --- Proaktywny push zdarzeń do Teams (ADR 0022) — GitHub (Jira nie pushuje zdarzeń, ADR 0054) ---
WORKMATE_TEAMS_PUSH_CLIENT_ID=
WORKMATE_TEAMS_PUSH_TENANT_ID=
# WORKMATE_TEAMS_PUSH_ENABLE_CHANNEL=false
# WORKMATE_TEAMS_PUSH_TEAM_ID=
# WORKMATE_TEAMS_PUSH_CHANNEL_ID=
# WORKMATE_TEAMS_PUSH_ENABLE_CHANNEL_THREADING=false

# =================================================================================================
# Retrieval notatek (ADR 0023) — lematyzacja PL domyślnie ON (extra `retrieval` jest w obrazie)
# =================================================================================================
# WORKMATE_RETRIEVAL_LEMMATIZE=true
# WORKMATE_RETRIEVAL_LANG=pl

# --- Katalog roboczy agenta (ADR 0018) — domyślnie OFF -------------------------------------------
# Jeśli włączysz WORKMATE_ENABLE_WORKSPACE=true, MUSISZ wskazać katalog na wolumenie (rootfs jest RO):
# domyślny ~/.workmate/workspace nie istnieje (uid 10001, --no-create-home) i zapis padnie.
# WORKMATE_ENABLE_WORKSPACE=false
# WORKMATE_WORKSPACE_DIR=/var/lib/workmate/workspace
