# Konfiguracja WorkMate. Skopiuj do `.env` i dostosuj w razie potrzeby.
# Zmienne serwera MCP są OPCJONALNE — bez nich serwer używa danych z ./data.
#
# Serwer MCP (Faza 1) nie wymaga sekretów — odczyt i zapis działają na plikach.
# Runtime agenta (Faza 2, extra `agent`) WYMAGA klucza Claude API: trzymaj go w
# lokalnym .env (w .gitignore), NIGDY w repo ani w data/ (patrz sekcja niżej).

# Nadpisania ścieżek danych (domyślnie liczone względem korzenia repozytorium):
# WORKMATE_DATA_DIR=./data
# WORKMATE_NOTES_DIR=./data/notes
# WORKMATE_PROJECTS_REGISTRY=./data/projects/registry.yaml

# Transport serwera: "stdio" (domyślny, lokalny Claude Code) lub
# "streamable-http" (wdrożenie sieciowe — Faza 1, tydzień 4 / Bramka 3).
# WORKMATE_TRANSPORT=stdio

# Poziom logowania.
# WORKMATE_LOG_LEVEL=INFO

# Zapis notatek (narzędzie save_note) — profil uprawnień per drzwi (ADR 0006).
# Domyślnie włączony dla lokalnych drzwi dev; mniej zaufane drzwi ustawiają false.
# WORKMATE_ENABLE_WRITE=true

# --- Tryb HTTP (streamable-http, Bramka 3 / ADR 0007) ------------------------
# Poniższe działają TYLKO przy WORKMATE_TRANSPORT=streamable-http.
# Pełna procedura: docs/how-to/deploy-http.md.
#
# Magazyn tokenów per osoba (sha256 w spoczynku). MUSI leżeć poza data/.
# WORKMATE_TOKENS_FILE=C:\ProgramData\WorkMate\tokens.json
# Adres i port nasłuchu uvicorn (za IIS: loopback).
# WORKMATE_BIND_HOST=127.0.0.1
# WORKMATE_BIND_PORT=8000
# Dozwolone nagłówki Host — DOŁÓŻ publiczny host w OBU formach (bez portu dla
# HTTPS/443 i z portem), inaczej realny Host daje 421.
# WORKMATE_ALLOWED_HOSTS=workmate.firma.pl,workmate.firma.pl:*,127.0.0.1:*,localhost:*
# WORKMATE_ALLOWED_ORIGINS=https://workmate.firma.pl
# TLS bezpośrednio w uvicorn (fallback bez IIS) — podaj oba naraz.
# WORKMATE_TLS_CERTFILE=C:\ProgramData\WorkMate\workmate.crt
# WORKMATE_TLS_KEYFILE=C:\ProgramData\WorkMate\workmate.key
# Uprawnienia minimalne dla drzwi HTTP: wyłącz zapis (tylko 4 narzędzia odczytu).
# WORKMATE_ENABLE_WRITE=false

# --- Drzwi Teams — wariant Bot Framework (Emulator/Azure) --------------------
# Osobny proces: `uv run workmate-teams` (wymaga: uv sync --extra teams).
# Pełna procedura Azure/Teams: docs/how-to/teams-bot.md.
# (Produkcyjny wariant delegowany Graph `workmate-teams-graph` — sekcja niżej.)
#
# TEST LOKALNY W EMULATORZE (bez Azure): ustaw tryb anonimowy, ID/hasło puste.
# WORKMATE_TEAMS_ANONYMOUS=true
#
# REALNY TEST W TEAMS: tożsamość single-tenant z Azure (Emulator nie obsługuje
# single-tenant — auth weryfikujesz przez dev tunnel + Teams). Brak TENANT_ID
# przy single-tenant to klasyczna przyczyna 401.
# WORKMATE_TEAMS_APP_ID=<Microsoft App ID z Azure Bot>
# WORKMATE_TEAMS_APP_PASSWORD=<client secret>
# WORKMATE_TEAMS_TENANT_ID=<Directory (tenant) ID>
# WORKMATE_TEAMS_BIND_HOST=localhost
# WORKMATE_TEAMS_PORT=3978

# --- Drzwi Teams — wariant delegowany Graph (ADR 0015/0016) ------------------
# Osobny proces: `uv run workmate-teams-graph` (wymaga: uv sync --extra teams-graph --extra agent
# + ANTHROPIC_API_KEY). Bot działa jako ZALOGOWANY użytkownik (device-code MSAL), bez endpointu.
# Pełna procedura: docs/how-to/teams-graph.md. Bez WATCH proces wypisze zespoły/kanały i zakończy.
# WORKMATE_TEAMS_GRAPH_CLIENT_ID=<client_id aplikacji Entra (public client)>
# WORKMATE_TEAMS_GRAPH_TENANT_ID=<tenant_id>
# Pary team_id:channel_id (po przecinku) do nasłuchu; puste = tryb odkrywania.
# WORKMATE_TEAMS_GRAPH_WATCH=<team_id>:<channel_id>
# Interwał pollingu (s) i limity kosztu API na rundę.
# WORKMATE_TEAMS_GRAPH_POLL_INTERVAL=10
# WORKMATE_TEAMS_GRAPH_TOP_ROOTS=20
# WORKMATE_TEAMS_GRAPH_TOP_REPLIES=50
# Cache tokenu MSAL to SEKRET (chmod 600) — poza repo i data/. Domyślnie ~/.workmate/teams_token_cache.bin.
# WORKMATE_TEAMS_GRAPH_TOKEN_CACHE=
# Limity załączników multimodalnych (ADR 0016): rozmiar / liczba / łączny budżet / ekstrakcja / krawędź obrazu (px).
# WORKMATE_TEAMS_GRAPH_MAX_ATTACHMENT_MB=8
# WORKMATE_TEAMS_GRAPH_MAX_ATTACHMENTS=20
# WORKMATE_TEAMS_GRAPH_MAX_TOTAL_ATTACHMENT_MB=20
# WORKMATE_TEAMS_GRAPH_MAX_EXTRACT_MB=50
# WORKMATE_TEAMS_GRAPH_MAX_IMAGE_EDGE=2048
# Odpowiedź agenta PLIKIEM w wątku (md/txt/pdf/docx, ADR 0026). Osobna bramka ZAPISU, domyślnie OFF.
# Wymaga: uv sync --extra file-reply ORAZ zakresu 'Files.ReadWrite.All' w SCOPES (po nadaniu usuń
# cache tokenu, by wymusić ponowną zgodę device-code). max_file_reply_kb: sufit rozmiaru pliku.
# WORKMATE_TEAMS_GRAPH_ENABLE_FILE_REPLY=false
# WORKMATE_TEAMS_GRAPH_MAX_FILE_REPLY_KB=512
# WORKMATE_TEAMS_GRAPH_SCOPES=ChannelMessage.Read.All,ChannelMessage.Send,Team.ReadBasic.All,Channel.ReadBasic.All,User.Read,Files.Read.All,Sites.Read.All,Files.ReadWrite.All
# Push agenta OBRAZEM do rozmówcy 1:1 (png/jpg/gif, ADR 0027). Osobna bramka ZAPISU, domyślnie OFF.
# Obraz idzie inline (hostedContents) — bez Files.* — ale dostawa 1:1 wymaga zakresów CZATU
# 'Chat.Create,ChatMessage.Send' w SCOPES (skonsentowane przez admina; po dodaniu usuń cache tokenu,
# by wymusić ponowną zgodę device-code). max_user_image_kb: sufit rozmiaru obrazu.
# WORKMATE_TEAMS_GRAPH_ENABLE_USER_FILE_PUSH=false
# WORKMATE_TEAMS_GRAPH_MAX_USER_IMAGE_KB=1024
# (przy włączonym push-u dopisz do SCOPES powyżej: ,Chat.Create,ChatMessage.Send)
# Push agenta DOKUMENTEM do rozmówcy 1:1 (md/txt/pdf/docx, ADR 0027, wariant plikowy). OSOBNA bramka
# od obrazowej, domyślnie OFF. SZERZEJ niż obraz: plik ląduje na OneDrive bota, więc wymaga ZARÓWNO
# zakresów CZATU 'Chat.Create,ChatMessage.Send' JAK I zapisu do WŁASNEGO dysku — wystarcza węższy
# 'Files.ReadWrite' (albo szerszy 'Files.ReadWrite.All', jeśli już nadany dla odpowiedzi plikiem).
# Po dodaniu do SCOPES usuń cache tokenu. Wymaga też: uv sync --extra file-reply (renderer pdf/docx).
# max_user_doc_kb: sufit rozmiaru zrenderowanego dokumentu.
# WORKMATE_TEAMS_GRAPH_ENABLE_USER_DOC_PUSH=false
# WORKMATE_TEAMS_GRAPH_MAX_USER_DOC_KB=512
# Produkcyjne M3 (ADR 0009, B1): pobranie transkryptu spotkania z Graph (`workmate-meeting
# --source graph --meeting <joinWebUrl|id>`). Osobna bramka, domyślnie OFF. Wymaga NOWYCH zakresów
# ADMINA (NADANE 2026-07-28): 'OnlineMeetingTranscript.Read.All' (treść transkryptu) +
# 'OnlineMeetings.Read' (rozwiązanie spotkania po joinWebUrl). Po nadaniu dopisz je do SCOPES i usuń
# cache tokenu, by wymusić ponowną zgodę device-code. Patrz docs/how-to/meeting-transcript-live-smoke.md.
# WORKMATE_TEAMS_GRAPH_ENABLE_MEETING_TRANSCRIPT=false
# (przy włączonym M3 dopisz do SCOPES powyżej: ,OnlineMeetingTranscript.Read.All,OnlineMeetings.Read)
# Produkcyjne M3 — ZAPIS notatki komendą `/notatka <ref> | <projekt> | <RRRR-MM-DD>` wprost z drzwi
# Teams (ADR 0009 §4 / 0041). Decyzja zaufania Gate-2 (zapis z mniej zaufanych drzwi), OSOBNA bramka,
# domyślnie OFF. Wymaga ENABLE_MEETING_TRANSCRIPT=true (źródło transkryptu) oraz extra 'agent' (Claude).
# Zapis jest create-only (nigdy nie nadpisuje, ADR 0006); o projekcie/dacie decyduje wpisujący, nie transkrypt.
# WORKMATE_TEAMS_GRAPH_ENABLE_MEETING_NOTE_WRITE=false
# Autoryzacja nadawcy /notatka (B2 / ADR 0042): mapa tożsamości AAD id -> członek pionu (fail-closed).
# WYMAGANA przy włączonej bramce zapisu (bez niej „każdy pisze do wszystkiego"). Ten sam plik (pole
# jira_user) zasila też "moje zadania" Jira na Teams (ADR 0054). Nieznany nadawca -> odmowa.
# WORKMATE_TEAMS_GRAPH_IDENTITIES=/opt/sufler/identities.yaml
# Async /notatka (B3 / ADR 0043): zamiast liczyć inline (blokuje poller na czas transkrypt+Claude),
# router odsyła ACK natychmiast i liczy w tle, wynik wrzuca do wątku. Wymaga ENABLE_MEETING_NOTE_WRITE=true
# (to jej tryb). Idempotencja (deterministyczny id) chroni retry. WORKERS = sufit równoległych łańcuchów.
# WORKMATE_TEAMS_GRAPH_ENABLE_MEETING_NOTE_ASYNC=false
# WORKMATE_TEAMS_GRAPH_MEETING_NOTE_ASYNC_WORKERS=2

# --- Runtime agenta (Faza 2, M1 / ADR 0008) --------------------------------
# Wymaga: uv sync --extra agent. Uruchomienie: `uv run workmate-agent "..."`.
# KLUCZ TO SEKRET — trzymaj go w lokalnym .env (w .gitignore), nigdy w repo ani
# w folderze data/. Priorytet: WORKMATE_AGENT_API_KEY, potem ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=<klucz Claude API>
# WORKMATE_AGENT_API_KEY=<opcjonalne nadpisanie klucza dla WorkMate>
# Domyślny model to claude-sonnet-5 (większe wymagania projektu wobec syntezy).
# WORKMATE_AGENT_MODEL=claude-sonnet-5
# max_tokens (128000 — pełny sufit modelu) dzieli budżet między myślenie i odpowiedź;
# adapter woła API streamingiem, więc duży sufit jest OK (non-streaming SDK odrzuca duże
# żądania). WORKMATE_AGENT_THINKING: adaptive (domyślnie, rozszerzone myślenie) albo
# disabled (np. dla ograniczenia kosztu/latencji).
# WORKMATE_AGENT_MAX_TOKENS=128000
# WORKMATE_AGENT_MAX_TOOL_ITERATIONS=8
# WORKMATE_AGENT_THINKING=adaptive

# --- Katalog roboczy agenta (ADR 0018) --------------------------------------
# Robocze pliki tekstowe agenta per rozmowa (create_file/read_file/list_files). Osobna bramka,
# domyślnie OFF (niezależna od zapisu notatek). Tylko tekst (md/txt/csv/json).
# WORKMATE_ENABLE_WORKSPACE=false
# WORKMATE_WORKSPACE_DIR=
# WORKMATE_WORKSPACE_MAX_FILE_MB=
# WORKMATE_WORKSPACE_MAX_FILES=
# WORKMATE_WORKSPACE_MAX_TOTAL_MB=
# WORKMATE_WORKSPACE_ALLOWED_EXT=md,txt,csv,json
# WORKMATE_WORKSPACE_RETENTION_DAYS=

# --- Pamięć rozmów (Faza 2 / ADR 0010, 0012) ---------------------------------
# Wątkowość rozmów użytkownika z botem: historia + limit kontekstu z rollover.
# Baza SQLite (stdlib, FTS5) — dane operacyjne, POZA repo i data/. Domyślnie w
# katalogu domowym (~/.workmate/conversations.db, pisemny bez uprawnień admina).
# WORKMATE_CONVERSATIONS_DB=C:\ProgramData\WorkMate\conversations.db
# Limit REALNEGO kontekstu rozmowy (z pola usage odpowiedzi API, Design 2). Domyślnie
# 128000 (przy 1M oknie) — po osiągnięciu bot startuje NOWĄ rozmowę. Realne input_tokens
# (system + narzędzia + cała historia co turę) są O RZĘDY większe niż dawna estymata.
# WORKMATE_CONV_MAX_TOKENS=128000
# Bezczynność (minuty), po której kolejna wiadomość zaczyna NOWY wątek (ADR 0012):
# osobne w czasie rozmowy = osobne wątki, zamiast jednej ciągnącej się nici.
# 0 wyłącza to kryterium (zostaje sam limit kontekstu powyżej).
# WORKMATE_CONV_IDLE_MINUTES=30

# --- Kompaktowanie historii (ADR 0014) ---------------------------------------
# Gdy włączone (domyślnie), ZASTĘPUJE rollover-na-limicie (WORKMATE_CONV_MAX_TOKENS):
# przy przekroczeniu progu stare tury zastępujemy JEDNYM podsumowaniem (osobne wywołanie
# modelu), zachowując ostatnie N wymian verbatim. Rollover bezczynności i '/nowa' działają
# dalej. Oryginały NIE są usuwane — zostają w bazie oznaczone jako zarchiwizowane.
# WORKMATE_COMPACTION_ENABLED=true
# Okno kontekstu modelu (tokeny) — baza do wyliczenia progu. Domyślnie 1000000 (Sonnet 5).
# WORKMATE_CONTEXT_WINDOW_TOKENS=1000000
# Próg triggera jako UŁAMEK okna (0,1]. Domyślnie 0.70 → kompaktowanie przy input_tokens
# ostatniej tury > 70% okna (przy 1M oknie: 700000 tokenów).
# WORKMATE_COMPACTION_THRESHOLD_FRACTION=0.70
# Ile ostatnich wymian (użytkownik→użytkownik) zostawić verbatim. Domyślnie 4.
# WORKMATE_COMPACTION_KEEP_TURNS=4
# Model do podsumowań; pusty = model agenta (WORKMATE_AGENT_MODEL, domyślnie Sonnet 5).
# WORKMATE_COMPACTION_MODEL=

# --- Faza 3: most GitHub ↔ Teams przez wspólny magazyn zdarzeń --------------
# Wspólny EventStore (SQLite, ADR 0019) — warstwa spajająca drzwi. Dane operacyjne,
# POZA repo i data/. Domyślnie ~/.workmate/events.db. OSOBNY plik od conversations.db.
# WORKMATE_EVENTS_DB=C:\ProgramData\WorkMate\events.db

# Licznik metryk użycia (Tor A, ADR 0049) — wywołania/drzwi, unikalni/tydzień, powracający.
# OPCJONALNY: ustawiony = zbieranie ON; pusty/niewpisany = metryki wyłączone. Pseudonim nadawcy
# (hash), nie surowe id; treści nie zapisuje. Odczyt: `workmate-metrics`. OSOBNY plik od events.db.
# WORKMATE_METRICS_DB=C:\ProgramData\WorkMate\metrics.db

# --- Drzwi GitHub (polling PAT, ADR 0020) — proces `workmate-github`, extra `github` ---
# PAT to SEKRET — nigdy w repo. Uprawnienia: odczyt issue/komentarzy (repo), a przy
# włączonym zapisie także tworzenie issue/komentarzy.
# WORKMATE_GITHUB_TOKEN=ghp_xxx
# WORKMATE_GITHUB_OWNER=biap
# WORKMATE_GITHUB_REPO=workmate
# Interwał pollingu (s) — sufit dolny 30 (świadomość limitu 5000 żądań/h). Domyślnie 60.
# WORKMATE_GITHUB_POLL_INTERVAL=60
# WORKMATE_GITHUB_PER_PAGE=50
# Rodzaje zdarzeń (ADR 0024/0029). Domyślnie: issues,comments. Opcjonalnie: pulls (nowe PR),
# pull_state (tranzycje PR merged/closed), branches (push/delete gałęzi — SHA-diff, zgrubne),
# reviews (recenzje PR — wymaga issues lub pulls), ci (wyniki workflow: sukces/porażka).
# WORKMATE_GITHUB_WATCH_KINDS=issues,comments,pulls,reviews,ci,pull_state,branches
# BRAMKA zapisu do GitHub (Gate 4, ADR 0021) — domyślnie OFF. Włącza narzędzia agenta
# create_github_issue/comment_github_issue (wpięte w drzwi teams_graph).
# WORKMATE_GITHUB_ENABLE_WRITE=false
# Auto-komentarz CI (ADR 0024, Faza 2) — domyślnie OFF. Deterministyczny (nie-LLM) komentarz na PR
# przy porażce CI. Wymaga WORKMATE_GITHUB_ENABLE_WRITE=true oraz 'ci' w WATCH_KINDS. Przed włączeniem
# potwierdź warunki z ADR 0024 (brak workflowów wyzwalanych komentarzem; jedna instancja procesu).
# WORKMATE_GITHUB_ENABLE_CI_AUTO_COMMENT=false
# Login konta PAT do self-skip (opcjonalny; inaczej ustalany z GET /user).
# WORKMATE_GITHUB_SELF_LOGIN=
# Propozycja czasu pracy z historii commitów (ADR 0034, część odczytowa) — BEZ BRAMKI.
# Narzędzie propose_worklog niczego nie mutuje (ścieżkę zapisu worklogu do Jiry usunięto
# 2026-07-21; logowanie czasu w imieniu innych zostało z projektu wycofane całkowicie, ADR 0055),
# a repo bramkuje zapis, nie odczyt. Wystarczy skonfigurowany GitHub powyżej. Poniższe pokrętła
# stroją estymację:
# przerwa kończąca sesję, czas doliczany PRZED pierwszym commitem, kwant zaokrąglenia w górę
# (1/5/10/15/30/60), sufit JEDNEJ sesji (max 24 h), szerokość okna zapytania (max 92 dni)
# oraz strefa liczenia doby — nazwa IANA, nie offset, więc zmiana czasu nie przesuwa dni.
# WORKMATE_GITHUB_WORKLOG_IDLE_GAP_MINUTES=90
# WORKMATE_GITHUB_WORKLOG_RAMP_UP_MINUTES=30
# WORKMATE_GITHUB_WORKLOG_ROUND_MINUTES=15
# WORKMATE_GITHUB_WORKLOG_MAX_SESSION_HOURS=8.0
# WORKMATE_GITHUB_WORKLOG_MAX_RANGE_DAYS=31
# WORKMATE_GITHUB_WORKLOG_TZ=Europe/Warsaw

# --- Jira: odczyt "moje zadania" (ADR 0054) — WYŁĄCZNIE odczyt, bez pollera/mostu/zapisu --------
# Most push/ingest (ADR 0030) i zapis/tranzycja (ADR 0031/0032) zostały USUNIĘTE — jedyna zdolność
# to lista otwartych zadań pytającego, zawężona server-side do jego własnego konta (nigdy parametr
# narzędzia). Na Teams tożsamość rozwiązuje mapa AAD→Jira (WORKMATE_TEAMS_GRAPH_IDENTITIES, pole
# jira_user); na serwerze MCP stdio (Claude Code/CLI, brak tożsamości Teams) — WORKMATE_JIRA_MY_ACCOUNT.
# Token Jira to SEKRET — nigdy w repo. Wystarczy zakres ODCZYTU (bez create/edit/transition).
# Wariant wdrożenia (ADR 0033): `server` (domyślnie — Server/DC, PAT Bearer, REST v2) lub
# `cloud` (Jira Cloud — Basic email+API-token, REST v3, search/jql).
# WORKMATE_JIRA_DEPLOYMENT=server
# URL: Server/DC = własny host (https://jira.firma.pl); Cloud = https://<site>.atlassian.net
# WORKMATE_JIRA_BASE_URL=https://jira.firma.pl
# Token: PAT (Server/DC) LUB API token z id.atlassian.com (Cloud).
# WORKMATE_JIRA_TOKEN=<token>
# E-mail konta — WYMAGANY tylko na Cloud (Basic auth: email:api_token). Na Server/DC zostaw pusty.
# WORKMATE_JIRA_EMAIL=
# Principal dla "moich zadań" NA SERWERZE MCP (login/e-mail/accountId) — JEDEN dla całego procesu.
# Sensowny TYLKO na lokalnym stdio jednego operatora (Claude Code/CLI): na transporcie
# streamable-http `server.py` konstrukcyjnie NIE rejestruje tego narzędzia (jak `save_note`),
# więc na współdzielonym fleecie HTTP ta zmienna jest bez efektu.
# WORKMATE_JIRA_MY_ACCOUNT=

# --- Proaktywny push zdarzeń do Teams (dual-target, ADR 0022) ---------------
# Tożsamość jak teams_graph (device-code MSAL); cache tokenu może być współdzielony.
# WORKMATE_TEAMS_PUSH_CLIENT_ID=c0ffee00-0000-4000-8000-000000000015
# WORKMATE_TEAMS_PUSH_TENANT_ID=c0ffee00-0000-4000-8000-000000000017
# Cel 1:1 (AAD user id adresata) — wymaga ENABLE_CHAT=true.
# WORKMATE_TEAMS_PUSH_CHAT_USER_ID=
# WORKMATE_TEAMS_PUSH_ENABLE_CHAT=false
# Cel kanałowy — wymaga ENABLE_CHANNEL=true + team/channel id.
# WORKMATE_TEAMS_PUSH_TEAM_ID=
# WORKMATE_TEAMS_PUSH_CHANNEL_ID=
# WORKMATE_TEAMS_PUSH_ENABLE_CHANNEL=false
# Wątkowanie kanału (ADR 0024, Faza 3) — domyślnie OFF. Zdarzenia tego samego issue/PR dokłada do
# JEDNEGO wątku (zamiast nowego posta za każdym razem). Wymaga ENABLE_CHANNEL=true.
# WORKMATE_TEAMS_PUSH_ENABLE_CHANNEL_THREADING=false
# Zakresy delegowane (puste = domyslne czat/kanal). Push dokumentu 1:1 (ADR 0027,
# ENABLE_USER_DOC_PUSH) wymaga DOLOZENIA zapisu do plikow — dopisz 'Files.ReadWrite'
# (wystarcza wlasny dysk) lub szerszy 'Files.ReadWrite.All'. Lista rozdzielana przecinkami.
# WORKMATE_TEAMS_PUSH_SCOPES=Chat.Create,Chat.ReadWrite,ChatMessage.Send,ChannelMessage.Send,User.Read,TeamMember.Read.All,Files.ReadWrite

# --- Retrieval notatek (ADR 0023, Faza A) — lepszy ranking wyszukiwania -------
# Lematyzacja polska (BM25 nad lematami, odporność na fleksję) — domyślnie ON, gdy
# zainstalowany extra `retrieval` (simplemma); brak extra degraduje do rankingu podłańcuchowego.
# Wyłączenie (do debugowania/porównań): WORKMATE_RETRIEVAL_LEMMATIZE=false
# WORKMATE_RETRIEVAL_LEMMATIZE=true
# WORKMATE_RETRIEVAL_LANG=pl
# Warstwa dense (osadzenia + RRF) to Faza B za bramką mikro-evalu — jeszcze niekonfigurowana.
