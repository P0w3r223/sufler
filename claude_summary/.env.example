# claude_summary — przykładowa konfiguracja. Skopiuj do .env (jest w .gitignore).
# Realne zmienne środowiskowe mają priorytet nad .env.

# Zgoda na czytanie prywatnej historii promptów (alternatywa dla flagi --consent).
CLAUDE_SUMMARY_CONSENT=false

# Strefa czasowa do grupowania po dniu (nazwa IANA, nie offset).
CLAUDE_SUMMARY_TZ=Europe/Warsaw

# Katalog transkryptów Claude Code (domyślnie ~/.claude/projects).
# CLAUDE_SUMMARY_PROJECTS_DIR=C:\Users\Ja\.claude\projects

# Katalog wyników (POZA repo — może zawierać prywatną treść promptów).
# CLAUDE_SUMMARY_OUTPUT_DIR=C:\Users\Ja\.claude-summary

# Domyślny zakres w dniach, gdy nie podano --since/--until.
CLAUDE_SUMMARY_DEFAULT_DAYS=7

# Domyślny filtr autora commitów (pusty → git config user.email repo).
# CLAUDE_SUMMARY_AUTHOR=ja@firma.pl

# Warstwa LLM (opis prozą). Wymaga extra 'agent' oraz klucza API.
CLAUDE_SUMMARY_LLM=false
# CLAUDE_SUMMARY_MODEL=claude-sonnet-5
# CLAUDE_SUMMARY_MAX_TOKENS=1024

# Klucz Claude API — SEKRET, tylko w .env (poza repo). CLAUDE_SUMMARY_API_KEY ma priorytet.
# ANTHROPIC_API_KEY=sk-ant-...
