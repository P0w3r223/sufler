# sekrety i dane
.env
probe_out/
# Pliki źródłowe klasyfikacji pobrane z GUS. Do repozytorium trafia wyłącznie **wynik**
# (`ceidg_tool/data/pkd2025.yaml`), a jego nagłówek niesie SHA-256 tego źródła — więc budowa
# jest odtwarzalna bez trzymania kilku megabajtów arkuszy w historii.
PKD/
*.xlsx
*.sqlite
*.sqlite3
*.db
*.csv
*.jsonl
*.ndjson
# Materiał demo. Zdalne repozytorium należy do innego zespołu, a `.json`/`.yaml` nie były
# dotąd ignorowane, więc nagranie albo zrzut z produkcji trafiłby do commita domyślnie
# (audyt 2026-09-08, Tier D3). Cokolwiek ma zostać w repozytorium, dopisuje się tu jawnie
# przez `!`, po przejściu przez anonimizator.
demo/recordings/
demo/raw/
scripts/demo/recordings/
scripts/demo/raw/
# Wyjątek zawężony 2026-09-09 (audyt architektury, pozycja F-O1). Stało tu
# `!tests/fixtures/**`, które odignorowywało **cały** katalog — razem z rozszerzeniami
# zakazanymi wyżej dlatego, że niosą dane osobowe. `git check-ignore` pokazywał, że
# `tests/fixtures/raport.csv`, `dane.sqlite` i `probka.ndjson` trafiłyby do commita, a to
# jest katalog, do którego **pisze anonimizator** i w którym naturalnie ląduje „szybka
# próbka". Wyjątek licencjonował więc dokładnie ten defekt, przed którym stoi reguła — przy
# zdalnym repozytorium należącym do innego zespołu. Wpuszczamy jawnie tylko te dwa
# rozszerzenia, które fixtures mają; każde następne dopisuje się tu świadomie.
!tests/fixtures/*.json
!tests/fixtures/*.yaml
.ceidg/
wyniki/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/

# ide
.idea/
.vscode/

# prompter pokazu — wydruk sceniczny `docs/demo-presentation.md`, generowany na potrzeby
# jednego wystąpienia i trzymany lokalnie. Źródłem prawdy jest markdown w `docs/`; plik HTML
# jest jego kopią, więc w repozytorium byłby drugą wersją tych samych zdań do utrzymania.
prompter-pokazu-ceidg.html
