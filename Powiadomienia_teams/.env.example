# Powiadomienia_teams — konfiguracja. Skopiuj do .env i uzupełnij. NIE commituj .env.
# Wartości poniżej to potwierdzone dane z tenanta BIAP (Smoke #1, 2026-07-14).

POWIADOMIENIA_CLIENT_ID=c0ffee00-0000-4000-8000-000000000015
POWIADOMIENIA_TENANT_ID=c0ffee00-0000-4000-8000-000000000017
POWIADOMIENIA_TEAM_ID=c0ffee00-0000-4000-8000-000000000019

# Opcjonalne
POWIADOMIENIA_SCHEDULING_GROUP_ID=TAG_c0ffee00-0000-4000-8000-000000000009
POWIADOMIENIA_ROSTER_PATH=./roster.yaml
POWIADOMIENIA_RUN_WEEKDAY=6
POWIADOMIENIA_RUN_HOUR=16
POWIADOMIENIA_RUN_MINUTE=0
POWIADOMIENIA_TIMEZONE=Europe/Warsaw
POWIADOMIENIA_REPLY_WINDOW_HOURS=48
# Jak często (s) listener sprawdza odpowiedzi — niżej = płynniejsza rozmowa. Domyślnie 10.
POWIADOMIENIA_POLL_INTERVAL_S=10
# Bezpiecznik: true = nic nie wysyła ani nie zapisuje (tylko log). Realne działanie: false.
POWIADOMIENIA_DRY_RUN=true
# Tryb pilotażowy: ogranicz powiadomienia do wskazanych AAD user-id (po przecinku). Pusty = wszyscy.
# POWIADOMIENIA_ONLY_USER_IDS=c0ffee00-0000-4000-8000-000000000001

# Ścieżki stanu/tokenu (domyślnie współdzielone z drzwiami teams_graph)
# POWIADOMIENIA_TOKEN_CACHE=~/.workmate/teams_token_cache.bin
# POWIADOMIENIA_STATE_PATH=~/.workmate/powiadomienia_state.json

# Klucz Claude do interpretacji odpowiedzi (Etap 4)
ANTHROPIC_API_KEY=
# Model Claude do interpretacji (opcjonalnie; domyślnie claude-haiku-4-5 — szybki i tani).
# Dla trudniejszych odpowiedzi można podnieść, np. claude-sonnet-5.
# POWIADOMIENIA_LLM_MODEL=claude-haiku-4-5
