# Powiadomienia_teams — konfiguracja do uruchomienia LOKALNEGO (z konta, nie w kontenerze).
# Skopiuj do `.env` i uzupełnij. NIE commituj `.env`.
#
# ŹRÓDŁEM PRAWDY dla pełnej listy kluczy jest `deploy/env.example` — tam każdy klucz ma opis
# i wartość domyślną, i tam jest weryfikowany wobec `config.py`. Ten plik świadomie NIE powtarza
# tamtej listy: dwie kopie tego samego zestawu rozjechały się już raz i przez kilka wydań
# dokumentowały klucze, których kod nie czytał.
#
# Poniżej wyłącznie to, czym uruchomienie lokalne RÓŻNI SIĘ od serwerowego.

# --- Wymagane (wartości jak na serwerze) ------------------------------------
POWIADOMIENIA_CLIENT_ID=<client id aplikacji Azure AD>
POWIADOMIENIA_TENANT_ID=<tenant id Azure AD>
POWIADOMIENIA_TEAM_ID=<id zespołu Teams>
POWIADOMIENIA_SCHEDULING_GROUP_ID=<id grupy harmonogramowania Shifts>
POWIADOMIENIA_AGENT_API_KEY=<klucz API Anthropic>

# --- Różnice wobec serwera --------------------------------------------------
# Ścieżek NIE ustawiamy: domyślne `~/.workmate/…` są tu właściwe. Na serwerze muszą wskazywać
# punkt montowania wolumenu i dlatego tam są podane jawnie.

# Zostaw `true`. Na maszynie deweloperskiej `false` pisze do PRAWDZIWYCH ludzi w tenancie
# klienta i zapisuje do PRAWDZIWEGO grafiku — nie ma osobnego środowiska testowego.
POWIADOMIENIA_DRY_RUN=true

# Do pracy na żywym tenancie bez ruszania produkcji służy `--proba-nasluchu`
# (odczyty prawdziwe, zapisy i wiadomości odcięte). Uwaga: bierze blokadę na PRODUKCYJNYM pliku
# stanu, więc nie uruchomisz jej równolegle z działającą usługą.

# Zawężenie kręgu odbiorców na czas prób. Obie zmienne muszą się zgadzać — `PILOTAZ=true`
# przy pustej liście zatrzymuje start.
POWIADOMIENIA_ONLY_USER_IDS=
POWIADOMIENIA_PILOTAZ=false
