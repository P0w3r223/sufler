# Powiadomienia_teams — konfiguracja. Skopiuj do .env i uzupełnij. NIE commituj .env.
# Identyfikatory tenanta/zespołu poniżej są zastąpione placeholderami — wartość w `.env`
# (odczytać z rejestracji aplikacji Azure AD i konfiguracji zespołu Teams w tenancie BIAP).

POWIADOMIENIA_CLIENT_ID=<client id aplikacji Azure AD>
POWIADOMIENIA_TENANT_ID=<tenant id Azure AD>
POWIADOMIENIA_TEAM_ID=<id zespołu Teams>

# Opcjonalne
POWIADOMIENIA_SCHEDULING_GROUP_ID=<id grupy harmonogramowania Shifts>
# Termin cotygodniowego przypomnienia. Dzień: 0=pon … 4=piątek … 6=niedziela. Domyślnie piątek 16:00
# (prośba o uzupełnienie grafiku na NASTĘPNY tydzień, jeszcze przed weekendem).
POWIADOMIENIA_RUN_WEEKDAY=4
POWIADOMIENIA_RUN_HOUR=16
POWIADOMIENIA_RUN_MINUTE=0
POWIADOMIENIA_TIMEZONE=Europe/Warsaw
# Po ilu godzinach ciszy zamknąć okno odpowiedzi (status EXPIRED, koniec odpytywania tej osoby).
# Sam upływ czasu NIE wystarcza — zamknięcie wymaga udanego odczytu czatu, który nic nie przyniósł
# (ADR 0003), więc przestój usługi ani awaria Graph nie wypalają pracownikowi okna.
POWIADOMIENIA_REPLY_WINDOW_HOURS=48
# Czy wysyłać pracownikowi uprzejme domknięcie, gdy temat gaśnie SAM (true/false). Obejmuje brak
# odpowiedzi i brak potwierdzenia. NIE obejmuje odpowiedzi na jawne „tak" pracownika — na nią bot
# odzywa się zawsze, także gdy okazało się, że nie ma już czego zapisać: milczenie po
# potwierdzeniu jest gorsze niż samo domknięcie.
POWIADOMIENIA_SEND_EXPIRY_MESSAGE=true
# Bazowy (minimalny) odstęp odpytywania w s; backoff wydłuża go w miarę ciszy. Domyślnie 10.
POWIADOMIENIA_POLL_INTERVAL_S=10
# Górny limit odstępu przy długiej ciszy (s) — chroni przed zbędnym odpytywaniem. Domyślnie 3600
# (1 h): przy nieobecnym pracowniku sprawdzamy czat raz na godzinę zamiast setki razy dziennie.
# Backoff wraca do POLL_INTERVAL_S natychmiast po obsłużeniu odpowiedzi, więc sama rozmowa
# (odpowiedź → potwierdzenie → zapis) biegnie w sekundach, nie w godzinach.
POWIADOMIENIA_POLL_MAX_INTERVAL_S=3600
# Nadrobienie: ile h po minionym terminie wolno jeszcze wykonać zaległy przebieg (0 = wyłącz).
# Chroni przed utratą tygodnia przy restarcie/awarii tuż po terminie. Domyślnie 6.
POWIADOMIENIA_CATCHUP_GRACE_HOURS=6
# AAD user-id administratora — odbiorca podsumowania po każdym przebiegu (sygnał życia usługi).
POWIADOMIENIA_ADMIN_USER_ID=
# Webhook alertów: dowolny endpoint HTTPS przyjmujący POST z JSON, NIEZALEŻNY od Graph — bo alert
# „utracono sesję" powstaje dokładnie wtedy, gdy Teams przestaje być dostępnym kanałem.
POWIADOMIENIA_ALERT_WEBHOOK_URL=
# Co ile godzin sprawdzać ważność sesji poza przebiegiem tygodniowym. Domyślnie 24.
POWIADOMIENIA_HEARTBEAT_INTERVAL_H=24
# Ile czekać przed wyjściem po utracie sesji (ogranicza pętlę restartów). Domyślnie 600.
POWIADOMIENIA_AUTH_FAILURE_EXIT_DELAY_S=600
# Po jakim czasie bez pulsu HEALTHCHECK uzna pętlę za martwą. NIEZALEŻNE od sufitu nasłuchu —
# puls bije co minutę, więc próg nie musi rosnąć razem z odstępem odpytywania Graph.
POWIADOMIENIA_HEALTH_MAX_AGE_S=900
# Bezpiecznik: true = nic nie wysyła ani nie zapisuje (tylko log). Realne działanie: false.
POWIADOMIENIA_DRY_RUN=true
# WYBÓR OSÓB: ogranicz powiadomienia do wskazanych AAD user-id (po przecinku). Pusty = wszyscy
# członkowie zespołu bez zmian na następny tydzień. To główny sposób wskazania „wybranych osób".
# POWIADOMIENIA_ONLY_USER_IDS=<lista AAD user-id po przecinku>

# Ścieżki stanu/tokenu (domyślnie współdzielone z drzwiami teams_graph)
# POWIADOMIENIA_TOKEN_CACHE=~/.workmate/teams_token_cache.bin
# POWIADOMIENIA_STATE_PATH=~/.workmate/powiadomienia_state.json

# Klucz Claude do interpretacji odpowiedzi (Etap 4)
ANTHROPIC_API_KEY=
# Model Claude do interpretacji (opcjonalnie; domyślnie claude-haiku-4-5 — szybki i tani).
# Dla trudniejszych odpowiedzi można podnieść, np. claude-sonnet-5.
# POWIADOMIENIA_LLM_MODEL=claude-haiku-4-5
