[Unit]
Description=Powiadomienia Teams — cotygodniowe przypomnienia o zmianach (Microsoft Shifts)
Documentation=file:/opt/teams-shifts-reminder/deploy/README-serwer.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=powiadomienia
Group=powiadomienia
WorkingDirectory=/opt/teams-shifts-reminder
EnvironmentFile=/etc/powiadomienia-teams/env
ExecStart=/opt/teams-shifts-reminder/.venv/bin/powiadomienia-teams

# UTF-8 nie jest kosmetyką: treści wiadomości mają emoji (✅😕🙂🟢🔵), a cache MSAL zawiera
# polskie znaki w claimie `name`. Pod systemd bez LANG locale to POSIX → ASCII, a wtedy zapis
# logu albo rotacja refresh-tokenu kończą się UnicodeEncodeError o objawie niezwiązanym z przyczyną.
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1

# Restart z limitem — CELOWO pozwalamy usłudze umrzeć na dobre. Utrata refresh-tokenu
# (AuthExpiredError) jest nienaprawialna automatycznie: potrzeba człowieka i `--login`.
# Restartowanie w nieskończoność tylko ukryłoby problem do następnego piątku.
Restart=on-failure
RestartSec=60
StartLimitIntervalSec=3600
StartLimitBurst=5

# Stan i cache MSAL POZA katalogiem kodu — przeżywają podmianę wersji.
# Katalog tworzony przez systemd z prawami 0700 dla użytkownika usługi.
StateDirectory=powiadomienia-teams
StateDirectoryMode=0700

# Hardening. ProtectHome=yes jest bezpieczne, BO ścieżki stanu i tokenu ustawiamy jawnie
# w EnvironmentFile — aplikacja nie sięga do Path.home().
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
