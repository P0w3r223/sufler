# Konfiguracja usługi powiadomienia-teams na serwerze.
#
# Docelowa lokalizacja:
#   Docker (obowiązujący):  /opt/teams-shifts-reminder/env   (chmod 640)
#   systemd (zapasowy):     /etc/powiadomienia-teams/env   (root:powiadomienia, chmod 640)
#
# Format wspólny dla `docker compose env_file` i systemd `EnvironmentFile`:
# KLUCZ=wartość, bez `export`, BEZ CUDZYSŁOWÓW, bez komentarzy na końcu linii z wartością.
# (Docker traktowałby cudzysłowy jako część wartości — stąd zakaz.)

# --- Tożsamość aplikacji i zespół (wymagane) --------------------------------
# CLIENT_ID i TENANT_ID nie zależą od tego, KTO jest głosem bota — identyfikują aplikację
# i organizację. Zmiana konta bota to wyłącznie ponowne `--login`, nie zmiana tych wartości.
# Wartości: patrz rejestracja aplikacji Azure AD (portal Entra ID).
POWIADOMIENIA_CLIENT_ID=<client id aplikacji Azure AD>
POWIADOMIENIA_TENANT_ID=<tenant id Azure AD>
# Zespół „BIAP - Pion Inteligentnych Technologii" — JEDYNY z działającym grafikiem w tenancie
# (enabled=True, Europe/Warsaw, tydzień od poniedziałku). Zweryfikowane 2026-07-21 zapisem
# i usunięciem zmian na pustym tygodniu. Id: portal Teams/Graph Explorer (`GET /me/joinedTeams`).
POWIADOMIENIA_TEAM_ID=<id zespołu Teams>
# Inne zespoły w tenancie BEZ utworzonego grafiku — odczyt zmian zwraca 404, NIE używać ich id
# tutaj (lista aktualnych kandydatów: `scripts/lista_czlonkow.py` lub Graph Explorer).

# Grupa AKTYWNA tego grafiku (`isActive=true`). Nieaktywne grupy harmonogramowania w tym samym
# zespole NIE są tu używane — zapisy trafiałyby do nieużywanej grupy.
POWIADOMIENIA_SCHEDULING_GROUP_ID=<id grupy harmonogramowania Shifts>

# --- ODBIORCY (zmieniane najczęściej) ---------------------------------------
# Lista AAD user-id po przecinku. PUSTY = wszyscy członkowie zespołu bez zmian
# na następny tydzień. Identyfikatory wypisze: scripts/lista_czlonkow.py
#
# Zmiana odbiorców NIE wymaga ponownego wdrożenia — edytuj tę linię i zrób:
#     sudo systemctl restart powiadomienia-teams
#
# Konto bota jest pomijane RÓWNIEŻ przez kod (`run_once` odfiltrowuje `get_me()`), więc pusta
# wartość tutaj nie grozi już pisaniem bota do samego siebie — ale nadal oznacza „wszyscy
# członkowie". Lista imion↔id — patrz wewnętrzna dokumentacja zespołu, nie ten plik.
POWIADOMIENIA_ONLY_USER_IDS=<lista AAD user-id po przecinku>

# --- Ścieżki (JAWNIE — nie polegać na Path.home()) --------------------------
# Docker:  punkt montowania wolumenu `powiadomienia-teams-stan` (te wartości MUSZĄ się zgadzać
#          z sekcją volumes w docker-compose.yml, inaczej stan zniknie po restarcie).
# systemd: unit ma ProtectHome=yes i StateDirectory, więc katalog domowy jest niedostępny.
# W obu wariantach te dwa pliki muszą przeżyć podmianę wersji.
POWIADOMIENIA_TOKEN_CACHE=/var/lib/powiadomienia-teams/teams_token_cache.bin
POWIADOMIENIA_STATE_PATH=/var/lib/powiadomienia-teams/powiadomienia_state.json

# --- Termin przypomnienia ---------------------------------------------------
# Dzień: 0=poniedziałek … 4=piątek … 6=niedziela
POWIADOMIENIA_RUN_WEEKDAY=4
POWIADOMIENIA_RUN_HOUR=16
POWIADOMIENIA_RUN_MINUTE=0
POWIADOMIENIA_TIMEZONE=Europe/Warsaw

# --- Okno odpowiedzi i nasłuch ----------------------------------------------
POWIADOMIENIA_REPLY_WINDOW_HOURS=48
# Wycisza komunikaty tematów gasnących SAMYCH (brak odpowiedzi, brak potwierdzenia). Odpowiedź na
# jawne „tak" pracownika idzie zawsze — również ta o tym, że nie ma już czego zapisać.
POWIADOMIENIA_SEND_EXPIRY_MESSAGE=true
# Po ilu s ciszy sprawdzić, czy pracownik uzupełnił grafik SAM w Shifts (bez odpowiedzi na czacie)
# — jeśli tak, zamknij temat (SELF_FILLED) i podziękuj zamiast czekać na EXPIRED (ADR 0004).
# -1 wyłącza sprawdzanie, 0 = na każdym takcie.
POWIADOMIENIA_SELF_FILL_CHECK_MIN_IDLE_S=3600
POWIADOMIENIA_POLL_INTERVAL_S=10
# Sufit backoffu: nieobecny pracownik = sprawdzanie czatu raz na godzinę. Po wykryciu odpowiedzi
# odstęp wraca do POLL_INTERVAL_S, więc rozmowa nie zwalnia.
POWIADOMIENIA_POLL_MAX_INTERVAL_S=3600
POWIADOMIENIA_CATCHUP_GRACE_HOURS=6

# --- Praca bezobsługowa -----------------------------------------------------
# AAD user-id administratora — dostaje podsumowanie po KAŻDYM przebiegu. To „dead man's switch":
# brak wiadomości w piątek wieczorem jest jedynym sygnałem awarii w instalacji bez monitoringu.
# Identyfikator bierzesz z `scripts/lista_czlonkow.py` (krok 4 README).
POWIADOMIENIA_ADMIN_USER_ID=
# Webhook alertów — DOWOLNY endpoint HTTPS przyjmujący POST z JSON (np. Teams Workflows).
# Musi być NIEZALEŻNY od Microsoft Graph: najważniejszy alert („utracono sesję") powstaje wtedy,
# gdy token do Graph przestał działać, więc Teams nie jest już kanałem, którym da się go wysłać.
# Bywa sekretem (token w URL-u) — plik ma prawa 640 nie bez powodu.
POWIADOMIENIA_ALERT_WEBHOOK_URL=
# Co ile godzin sprawdzić ważność sesji poza przebiegiem tygodniowym. Bez tego utrata sesji
# w poniedziałek wyszłaby dopiero w piątek o 16:00 — za późno, żeby zdążyć zareagować.
POWIADOMIENIA_HEARTBEAT_INTERVAL_H=24
# Ile czekać przed wyjściem po utracie sesji. Przy `restart: unless-stopped` bez tego opóźnienia
# martwy token oznaczałby restart kontenera co sekundę.
POWIADOMIENIA_AUTH_FAILURE_EXIT_DELAY_S=600
# Po jakim czasie bez pulsu HEALTHCHECK uzna pętlę za martwą. NIEZALEŻNE od sufitu nasłuchu —
# puls bije co minutę, więc próg nie musi rosnąć razem z odstępem odpytywania Graph.
POWIADOMIENIA_HEALTH_MAX_AGE_S=900

# --- BEZPIECZNIK ------------------------------------------------------------
# true  = nic nie wysyła ani nie zapisuje, tylko loguje co BY zrobiło
# false = praca na żywo (wymaga SCHEDULING_GROUP_ID oraz ANTHROPIC_API_KEY)
POWIADOMIENIA_DRY_RUN=true

# --- Sekret -----------------------------------------------------------------
# Klucz Claude do interpretacji odpowiedzi. Przy DRY_RUN=false jest WYMAGANY:
# bez niego bot wysłałby prośby, na które nigdy by nie odpowiedział.
# To jedyny sekret w tym pliku — stąd chmod 640 i grupa usługi.
ANTHROPIC_API_KEY=

# Model interpretujący (opcjonalnie; domyślnie claude-haiku-4-5 — szybki i tani).
# POWIADOMIENIA_LLM_MODEL=claude-haiku-4-5
