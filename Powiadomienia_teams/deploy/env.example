# Konfiguracja usługi powiadomienia-teams na serwerze.
#
# ZAKRES: ten plik opisuje obraz **0.2.19** — ten, który realnie działa u klienta.
# Zestaw kluczy zweryfikowany maszynowo wobec `config.py:from_env`, nie przepisany z pamięci.
#
# Docelowa lokalizacja:
#   Docker (obowiązujący):  /opt/teams-shifts-reminder/env   (chmod 640)
#   systemd (zapasowy):     /etc/powiadomienia-teams/env   (root:powiadomienia, chmod 640)
#
# Format wspólny dla `docker compose env_file` i systemd `EnvironmentFile`:
# KLUCZ=wartość, bez `export`, BEZ CUDZYSŁOWÓW, bez komentarzy na końcu linii z wartością.
# (Docker traktowałby cudzysłowy jako część wartości — stąd zakaz.)
#
# Nierozpoznana wartość logiczna ZATRZYMUJE START. `fasle`, `prawda`, `"true"` w cudzysłowach czy
# ucięte `tru` nie dają cicho `false` — to była fail-open bramka nad wysyłką do całego zespołu.

# --- Tożsamość aplikacji i zespół (wymagane) --------------------------------
# CLIENT_ID i TENANT_ID nie zależą od tego, KTO jest głosem bota — identyfikują aplikację
# i organizację. Zmiana konta bota to wyłącznie ponowne `--login`, nie zmiana tych wartości.
POWIADOMIENIA_CLIENT_ID=<client id aplikacji Azure AD>
POWIADOMIENIA_TENANT_ID=<tenant id Azure AD>
# Zespół z DZIAŁAJĄCYM grafikiem (enabled=True, Europe/Warsaw, tydzień od poniedziałku).
# Zespoły bez utworzonego grafiku zwracają 404 przy odczycie zmian — nie używać ich id.
POWIADOMIENIA_TEAM_ID=<id zespołu Teams>
# Grupa AKTYWNA tego grafiku (`isActive=true`). Grupa nieaktywna przyjmie zapisy, których
# nikt nie ogląda. Pusty = bez zawężania do grupy.
POWIADOMIENIA_SCHEDULING_GROUP_ID=<id grupy harmonogramowania Shifts>

# --- BEZPIECZNIK: kto dostaje wiadomości ------------------------------------
# DRY_RUN domyślnie **true** (fail-safe). Dopiero jawne `false` wypuszcza wiadomości do ludzi
# i zapisy do grafiku klienta.
POWIADOMIENIA_DRY_RUN=true
# Lista AAD user-id po przecinku. PUSTY = WSZYSCY członkowie zespołu.
# Identyfikatory wypisze `scripts/lista_czlonkow.py`.
POWIADOMIENIA_ONLY_USER_IDS=
# Deklaracja ZAMIARU zawężenia, niezależna od samej listy. Włączony PILOTAZ przy PUSTEJ liście
# zatrzymuje start. Sens: literówka w nazwie zmiennej (`ONLY_USER_ID`, zły prefiks) zamienia
# pilotaż na pięciu osobach w wysyłkę do całego zespołu — bezgłośnie, bo pusta lista jest
# nieodróżnialna od świadomie pustej. Wysyłki nie da się cofnąć.
POWIADOMIENIA_PILOTAZ=false

# --- Ścieżki (JAWNIE — nie polegać na Path.home()) --------------------------
# Domyślne (~/.workmate/…) są dobre dla uruchomienia z konta, NIE dla kontenera.
# Docker: muszą wskazywać punkt montowania wolumenu `powiadomienia-teams-stan`, inaczej stan
# znika po restarcie, a najbliższy przebieg pyta te same osoby drugi raz.
POWIADOMIENIA_TOKEN_CACHE=/var/lib/powiadomienia-teams/teams_token_cache.bin
POWIADOMIENIA_STATE_PATH=/var/lib/powiadomienia-teams/powiadomienia_state.json

# --- Termin przebiegu tygodniowego ------------------------------------------
# Dzień: 0=pon … 4=piątek … 6=niedziela. Domyślnie piątek 16:00 — prośba o grafik na NASTĘPNY
# tydzień, jeszcze przed weekendem.
POWIADOMIENIA_RUN_WEEKDAY=4
POWIADOMIENIA_RUN_HOUR=16
POWIADOMIENIA_RUN_MINUTE=0
POWIADOMIENIA_TIMEZONE=Europe/Warsaw
# Ile godzin łaski na NADROBIENIE przebiegu po awarii. Godziny ciszy tego okna NIE zjadają —
# przesuwają nadrabianie, a nie unieważniają je.
POWIADOMIENIA_CATCHUP_GRACE_HOURS=6
# Sufit czasu na JEDEN przebieg (tygodniowy albo obieg nasłuchu). 0 wyłącza.
POWIADOMIENIA_RUN_DEADLINE_S=1800

# --- Termin odpowiedzi (KALENDARZOWY, nie „liczba godzin") ------------------
# Termin = północ poniedziałku tygodnia DOCELOWEGO + tyle godzin. Domyślnie +5, czyli poniedziałek
# 05:00 — godzinę przed pierwszą zmianą.
POWIADOMIENIA_REPLY_DEADLINE_OFFSET_H=5
# Dolna granica kurtuazji: nigdy nie zamykaj tematu wcześniej niż tyle godzin po OSTATNIEJ prośbie
# bota. Chroni przed terminem wypadającym w przeszłości.
POWIADOMIENIA_REPLY_MIN_HOURS=24
# Jak długo trzymać w stanie wpisy już zamknięte (do raportu i do dedupu).
POWIADOMIENIA_TERMINAL_RETAIN_HOURS=48
# Czy wysyłać wiadomość o wygaśnięciu okna. Odpowiedź na jawne „tak" pracownika idzie zawsze.
POWIADOMIENIA_SEND_EXPIRY_MESSAGE=true
# Twardy sufit WIEKU wpisu, którego nie da się rozstrzygnąć, bo czatu nie da się odczytać
# (ADR 0007). To NIE jest okno odpowiedzi ani termin — dotyczy wyłącznie wpisów, dla których
# odczyt czatu pada obieg po obiegu. Po tym czasie wpis schodzi z obiegu PO CICHU: pracownik nie
# dostaje żadnej wiadomości (nie wiemy, czy odpisał — nie mamy jak sprawdzić), a operator dostaje
# alert. Bez sufitu taki wpis blokuje przypomnienie tej osoby w KAŻDYM kolejnym tygodniu.
#
# 144 h = 6 dób, czyli doba KRÓCEJ niż cykl tygodniowy. Ta doba jest wyliczona, nie zapasowa:
# przy 168 h zamknięcie wypadałoby dokładnie w chwili kolejnego przebiegu, który nadpisałby wpis
# i zaalarmował o uzgodnieniu, którego nigdy nie było. Doba pokrywa okno łaski (6 h), odłożenie
# obiegu na godziny ciszy (do 11 h) i dryf DST (1 h).
#
# Wartości dozwolone: > REPLY_MIN_HOURS i <= 168. Zera NIE ma — sufitu nie da się wyłączyć,
# bo wyłączony przywraca dokładnie tę usterkę, i to bezgłośnie.
POWIADOMIENIA_SUFIT_WPISU_BEZ_ODCZYTU_H=144

# --- Godziny ciszy ----------------------------------------------------------
# Nie pisz do PRACOWNIKÓW między `od` a `do` (czas lokalny zespołu). RUN_HOUR wpadający w ciszę
# jest konfiguracją legalną, ale usługa ostrzega o tym przy starcie.
POWIADOMIENIA_CISZA_OD_H=20
POWIADOMIENIA_CISZA_DO_H=7

# --- Nasłuch odpowiedzi -----------------------------------------------------
POWIADOMIENIA_POLL_INTERVAL_S=10
# Sufit backoffu: nieobecny pracownik nie ma być odpytywany co 10 s. Po jego odpowiedzi odstęp
# wraca do POLL_INTERVAL_S, więc rozmowa nie zwalnia.
POWIADOMIENIA_POLL_MAX_INTERVAL_S=3600
# Po jakim czasie bezczynności sprawdzić, czy pracownik uzupełnił grafik SAM (wtedy bot dziękuje
# i zamyka temat, zamiast dopominać się o coś, co już jest).
POWIADOMIENIA_SELF_FILL_CHECK_MIN_IDLE_S=3600

# --- Model językowy ---------------------------------------------------------
POWIADOMIENIA_LLM_MODEL=claude-haiku-4-5
# Nazwa KANONICZNA. `ANTHROPIC_API_KEY` (bez prefiksu) nadal działa jako alias konwencji SDK,
# ale usługa ostrzega przy starcie — jedna rzecz ma mieć jedną nazwę.
POWIADOMIENIA_AGENT_API_KEY=<klucz API Anthropic>

# --- Praca bezobsługowa -----------------------------------------------------
# AAD id administratorów po przecinku — odbiorcy podsumowania po KAŻDYM przebiegu.
# LISTA, nie skalar, i to jest istotne: podsumowanie jest dead man's switchem, a przy JEDNYM
# odbiorcy przełącznik jest martwy przez cały jego urlop — czyli dokładnie wtedy, gdy nie ma komu
# zauważyć awarii, nie ma też komu zauważyć jej braku. Wpisz co najmniej dwie osoby.
# Stara skalarna `POWIADOMIENIA_ADMIN_USER_ID` nadal działa i SUMUJE SIĘ z tą listą (duplikaty
# odpadają), ale jest wycofywana — usługa ostrzega przy starcie.
POWIADOMIENIA_ADMIN_USER_IDS=<aad id 1>,<aad id 2>
# Webhook alertów — DOWOLNY endpoint HTTPS przyjmujący POST z JSON.
# Musi być NIEZALEŻNY od Microsoft Graph: najważniejszy alert („utracono sesję") powstaje wtedy,
# gdy token do Graph przestał działać, więc Teams nie jest już kanałem, którym da się go wysłać.
# BYWA SEKRETEM (token w URL-u) — plik ma prawa 640 nie bez powodu. Uwaga: klient HTTP loguje
# URL żądania na poziomie INFO, więc webhook trafia do logów kontenera.
POWIADOMIENIA_ALERT_WEBHOOK_URL=<https://…>
# Jawna rezygnacja z alertowania przy DRY_RUN=false. Furtka, nie domyślność: bez niej instalacja,
# w której ktoś przeoczył webhooka, wygląda identycznie jak taka, w której zrezygnowano świadomie.
# Przy DRY_RUN=false brak webhooka I brak tej zgody ZATRZYMUJE START.
POWIADOMIENIA_ALERTY_WYLACZONE=false
# Czy logi i alerty mają nazywać pracownika nazwiskiem, czy identyfikatorem (A10). Domyślnie
# identyfikator: alert zostaje w kanale Teams bezterminowo i jest przeszukiwalny, a logi kontenera
# podlegają rotacji, nie polityce retencji. Włączenie to świadome poszerzenie tego, co opuszcza
# instalację — nie ustawienie wygody.
POWIADOMIENIA_LOGUJ_NAZWISKA=false

# --- Zdrowie i odporność ----------------------------------------------------
# Co ile godzin sprawdzić ważność sesji poza przebiegiem tygodniowym. Bez tego utrata sesji
# w poniedziałek wyszłaby dopiero w piątek o 16:00 — za późno, żeby zdążyć zareagować.
POWIADOMIENIA_HEARTBEAT_INTERVAL_H=24
# Ile czekać przed wyjściem po utracie sesji. Przy `restart: unless-stopped` bez tego opóźnienia
# martwy token oznaczałby restart kontenera co sekundę.
POWIADOMIENIA_AUTH_FAILURE_EXIT_DELAY_S=600
# Po jakim czasie bez pulsu HEALTHCHECK uzna pętlę za martwą. NIEZALEŻNE od sufitu nasłuchu —
# puls bije co minutę, więc próg nie musi rosnąć razem z odstępem odpytywania Graph.
POWIADOMIENIA_HEALTH_MAX_AGE_S=900
