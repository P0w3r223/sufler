# Kontekst budowania — im mniejszy, tym szybsze `docker build`.
# SEKRETY: .env wykluczony JAWNIE. Konfiguracja wchodzi przez --env-file w czasie URUCHOMIENIA,
# nigdy przez warstwę obrazu (warstwy są nieusuwalne i wędrują razem z obrazem).
.env
.env.*
!.env.example
roster.yaml

.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

.git/
.gitignore

# Dokumentacja i narzędzia deweloperskie — nie są potrzebne w obrazie.
docs/
PLAN.md
scripts/pack.sh
deploy/
# ...poza jednym plikiem: szablon konfiguracji jest przedmiotem bramki w etapie `test`.
# Sekretu tu nie ma — prawdziwy `env` mieszka na serwerze i wchodzi przez `--env-file`.
!deploy/env.example

# Artefakty wcześniejszego wariantu wdrożenia (tarball).
*.tar.gz
